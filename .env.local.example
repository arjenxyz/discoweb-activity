# Example environment variables for local development / docs
# Copy this to .env.local and fill in real values. DO NOT commit .env.local.

# Public (client-side) Supabase keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Server (secret) Supabase credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-secret

# Discord bot (server-only) — SECRET
DISCORD_BOT_TOKEN=your-discord-bot-token

# IDs and optional overrides
DISCORD_GUILD_ID=1465698764453838882
DEVELOPER_GUILD_ID=1465698764453838882
DEVELOPER_ROLE_ID=1467580199481639013

# Kişisel Mari cüzdanı (Discord sunucusu değil; borsadan bağımsız)
# Eski borsa kurulumunda "platform" kullanıldıysa aynı değeri verin
MARI_WALLET_GUILD_ID=__mari__

# API endpoints
BOT_API_URL=http://localhost:3000

# Optional public links
NEXT_PUBLIC_DISCORD_BOT_INVITE=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base API URL (used by Discord Activity embed to avoid proxy origin issues)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Timeouts (ms)
DISCORD_API_TIMEOUT_MS=10000

# Cron (cron-job.org / harici scheduler)
# cron-job.org: URL'de secret kullanmayın; Request headers ile gönderin.
#   Authorization: Bearer <CRON_SECRET>
#   veya X-Cron-Secret: <CRON_SECRET>
CRON_SECRET=your-cron-secret
# Supabase keepalive Discord bildirim kanalı
SUPABASE_KEEPALIVE_CHANNEL_ID=1520751495912489060
